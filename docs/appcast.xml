            <title>Version 1.5.2</title>
            <sparkle:version>9</sparkle:version>
            <sparkle:shortVersionString>1.5.2</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <pubDate>Sat, 20 Jun 2026 23:01:00 +1000</pubDate>
            <description><![CDATA[
                <h2>ScoreSort 1.5.2</h2>
                <p>Reliability fix: automatic updates now install correctly. (Earlier
                versions couldn't complete an in-app update — please update manually this
                once, and future updates will be automatic.)</p>
            ]]></description>
